10 REM CHROMATIC BREAKOUT - ORIGINAL MIT
20 REM C0F0 IS READONLY CHROMATIC BUTTONS
25 DIM B(8,3)
30 GR:HOME:P=18:X=20:Y=35:DX=1:DY=-1:S=0:L=3:BR=36:W=1:H=0:Q=0
40 COLOR=5:HLIN 0,39 AT 0:VLIN 0,39 AT 0:VLIN 0,39 AT 39
50 FOR R=0 TO 3:FOR C=0 TO 8:B(C,R)=1:COLOR=R+2
60 HLIN 2+4*C,4+4*C AT 4+2*R:HLIN 2+4*C,4+4*C AT 5+2*R:NEXT C:NEXT R
70 GOSUB 1400:GOSUB 1500:COLOR=15:PLOT X,Y:T$="A / SPACE TO LAUNCH":GOSUB 1600
80 VTAB 23:HTAB 1:PRINT "LEFT/RIGHT MOVE  A/SPACE LAUNCH";
90 VTAB 24:HTAB 1:PRINT "B PAUSE   MENU FOR CONTROLS";
100 K=PEEK(-16384):IF K<128 THEN K=0:GOTO 120
110 K=K-128:POKE -16368,0
120 OP=P:U=PEEK(49392):IF U=0 AND K=0 THEN 180
125 U=INT(U/32)
130 IF U=2 OR U=6 OR K=8 OR K=65 THEN P=P-2
140 IF U=1 OR U=5 OR K=21 OR K=68 THEN P=P+2
150 IF P<1 THEN P=1
160 IF P>33 THEN P=33
170 IF P<>OP THEN COLOR=0:HLIN OP,OP+5 AT 37:GOSUB 1400
180 J=PEEK(-16286)>127:IF J=0 OR Q=1 THEN 195
185 H=1-H:T$="PAUSED - B TO RESUME":IF H=0 THEN T$=""
190 GOSUB 1600
195 Q=J:IF H=1 THEN 100
200 IF W=1 THEN 700
220 NX=X+DX:NY=Y+DY
230 IF NX<1 OR NX>38 THEN DX=-DX:NX=X+DX
240 IF NY<1 THEN DY=1:NY=Y+DY
250 IF DY<=0 THEN 260
251 IF NY<>37 THEN 260
252 IF NX<P OR NX>P+5 THEN 260
253 DY=-1:NY=36:DX=1:IF NX<P+3 THEN DX=-1
260 IF NY>38 THEN 800
270 IF NY>11 THEN 400
272 IF NY<4 THEN 400
275 IF NX<2 OR NX>36 THEN 400
280 C=INT((NX-2)/4):R=INT((NY-4)/2)
290 IF NX>4+4*C OR B(C,R)=0 THEN 400
300 B(C,R)=0:BR=BR-1:S=S+10:COLOR=0
310 HLIN 2+4*C,4+4*C AT 4+2*R:HLIN 2+4*C,4+4*C AT 5+2*R
320 DY=-DY:NY=Y+DY:GOSUB 1500:IF BR=0 THEN 900
400 COLOR=15:PLOT NX,NY:COLOR=0:PLOT X,Y:X=NX:Y=NY:GOTO 100
700 NX=P+2:NY=35:IF NX=X AND NY=Y THEN 710
705 COLOR=15:PLOT NX,NY:COLOR=0:PLOT X,Y:X=NX:Y=NY
710 IF PEEK(-16287)<128 AND K<>32 AND K<>13 THEN 100
720 W=0:DX=1:DY=-1:IF RND(1)<.5 THEN DX=-1
730 T$="":GOSUB 1600:GOTO 100
800 L=L-1:GOSUB 1500:IF L=0 THEN 950
810 W=1:T$="A / SPACE TO LAUNCH":GOSUB 1600:GOTO 100
900 T$="YOU WIN! A / SPACE TO PLAY AGAIN":GOTO 1000
950 T$="GAME OVER - A / SPACE TO RESTART"
1000 GOSUB 1600
1010 IF PEEK(-16287)>127 THEN 1010
1020 K=PEEK(-16384):IF K>127 THEN K=K-128:POKE -16368,0
1030 IF PEEK(-16287)>127 OR K=32 OR K=13 THEN 30
1040 K=0:GOTO 1020
1400 COLOR=13:HLIN P,P+5 AT 37:RETURN
1500 VTAB 21:HTAB 1:PRINT "SCORE";S;" LIVES";L;" BRICKS";BR;"   ";:RETURN
1600 VTAB 22:HTAB 1:PRINT T$;SPC(39-LEN(T$));:RETURN
